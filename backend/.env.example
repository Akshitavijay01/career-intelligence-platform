# Career Intelligence Platform - Environment Configuration
# SQLite version for local Windows development

# Database Configuration - SQLite (no server required!)
DATABASE_URL=sqlite:///./career_intelligence.db

# For PostgreSQL (uncomment and configure for production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/career_intelligence_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=career_intelligence_db

# JWT Authentication
SECRET_KEY=career-intelligence-platform-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# AI/ML Configuration
# Set to false if you don't want to download ML models (simplified matching will be used)
USE_LOCAL_EMBEDDINGS=true

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Environment
DEBUG=true
LOG_LEVEL=info